<Window x:Class="CodexTokenWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Token Widget 设置" Width="390" Height="560"
        MinWidth="340" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="#F6F7F9" ShowInTaskbar="False">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,16,16,62">
      <Border Padding="20" Background="White" CornerRadius="14" BorderBrush="#E5E7EA" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="自动刷新" FontSize="17" FontWeight="SemiBold" Foreground="#282B30"/>
          <CheckBox x:Name="EnableAutoRefreshCheckBox" Content="启用自动刷新" Margin="0,14,0,8" FontSize="13" Foreground="#454850"
                    Checked="EnableAutoRefreshCheckBox_Changed" Unchecked="EnableAutoRefreshCheckBox_Changed"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
            <TextBlock Text="刷新频率" FontSize="13" Foreground="#454850" VerticalAlignment="Center"/>
            <ComboBox x:Name="IntervalComboBox" Grid.Column="1" Height="30" SelectedValuePath="Tag">
              <ComboBoxItem Content="每 1 分钟" Tag="1"/><ComboBoxItem Content="每 3 分钟" Tag="3"/>
              <ComboBoxItem Content="每 5 分钟" Tag="5"/><ComboBoxItem Content="每 10 分钟" Tag="10"/>
              <ComboBoxItem Content="每 15 分钟" Tag="15"/><ComboBoxItem Content="每 30 分钟" Tag="30"/>
              <ComboBoxItem Content="每 60 分钟" Tag="60"/>
            </ComboBox>
          </Grid>

          <TextBlock Text="启动" FontSize="17" FontWeight="SemiBold" Foreground="#282B30" Margin="0,24,0,10"/>
          <CheckBox x:Name="StartWithWindowsCheckBox" Content="开机自启动" Margin="0,0,0,9" FontSize="13"/>
          <CheckBox x:Name="StartWithCodexCheckBox" Content="跟随 Codex 启动" Margin="0,0,0,0" FontSize="13"/>

          <TextBlock Text="外观" FontSize="17" FontWeight="SemiBold" Foreground="#282B30" Margin="0,24,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
            <TextBlock Text="主题" FontSize="13" Foreground="#454850" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeModeComboBox" Grid.Column="1" Height="30" SelectedValuePath="Tag">
              <ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="白天" Tag="Light"/><ComboBoxItem Content="黑夜" Tag="Dark"/>
            </ComboBox>
          </Grid>
          <TextBlock Text="边缘进度条" FontSize="17" FontWeight="SemiBold" Foreground="#282B30" Margin="0,24,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
            <TextBlock Text="大小" FontSize="13" Foreground="#454850" VerticalAlignment="Center"/>
            <ComboBox x:Name="EdgeBarSizeComboBox" Grid.Column="1" Height="30" SelectedValuePath="Tag">
              <ComboBoxItem Content="小（默认）" Tag="67"/><ComboBoxItem Content="标准" Tag="100"/><ComboBoxItem Content="大" Tag="133"/>
            </ComboBox>
          </Grid>
          <TextBlock Text="显示卡片" FontSize="17" FontWeight="SemiBold" Foreground="#282B30" Margin="0,24,0,10"/>
          <CheckBox x:Name="ShowQuotaCardCheckBox" Content="5 小时与周限额" Margin="0,0,0,9" FontSize="13"/>
          <CheckBox x:Name="ShowTodayCardCheckBox" Content="今天 token 使用量" Margin="0,0,0,9" FontSize="13"/>
          <CheckBox x:Name="ShowChartCardCheckBox" Content="近 7 天柱状图" Margin="0,0,0,14" FontSize="13"/>
          <TextBlock Text="累计统计" FontSize="13" FontWeight="SemiBold" Foreground="#555961" Margin="0,0,0,9"/>
          <CheckBox x:Name="ShowLifetimeTokensCardCheckBox" Content="累计 Token 数" Margin="12,0,0,8" FontSize="13"/>
          <CheckBox x:Name="ShowPeakDailyTokensCardCheckBox" Content="峰值 Token 数" Margin="12,0,0,8" FontSize="13"/>
          <CheckBox x:Name="ShowLongestTurnCardCheckBox" Content="最长聊天时长" Margin="12,0,0,8" FontSize="13"/>
          <CheckBox x:Name="ShowCurrentStreakCardCheckBox" Content="当前连续天数" Margin="12,0,0,8" FontSize="13"/>
          <CheckBox x:Name="ShowLongestStreakCardCheckBox" Content="最长连续天数" Margin="12,0,0,0" FontSize="13"/>
        </StackPanel>
      </Border>
    </ScrollViewer>
    <Border Background="#F6F7F9" VerticalAlignment="Bottom" Height="54" Padding="16,10">
      <Grid>
        <TextBlock x:Name="VersionText" VerticalAlignment="Center" Foreground="#92959D" FontSize="11"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消" Width="76" Height="31" Margin="0,0,8,0" Click="CancelButton_Click"/>
          <Button Content="保存" Width="76" Height="31" Click="SaveButton_Click" Background="#43C979" Foreground="White" BorderBrush="#36B96C"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>



