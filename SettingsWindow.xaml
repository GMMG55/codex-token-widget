<Window x:Class="CodexTokenWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc18}" Width="460" Height="560"
        MinWidth="440" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="#F6F7F9" ShowInTaskbar="False">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,16,16,62">
      <Border Padding="20" Background="White" CornerRadius="14" BorderBrush="#E5E7EA" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc19}" FontSize="17" FontWeight="SemiBold" Foreground="#282B30"/>
          <CheckBox x:Name="EnableAutoRefreshCheckBox" Content="{DynamicResource Loc20}" Margin="0,14,0,8" FontSize="13" Foreground="#454850"
                    Checked="EnableAutoRefreshCheckBox_Changed" Unchecked="EnableAutoRefreshCheckBox_Changed"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Loc21}" FontSize="13" Foreground="#454850" VerticalAlignment="Center"/>
            <ComboBox x:Name="IntervalComboBox" Grid.Column="1" Height="30" SelectedValuePath="Tag">
              <ComboBoxItem Content="{DynamicResource Loc22}" Tag="1"/><ComboBoxItem Content="{DynamicResource Loc23}" Tag="3"/>
              <ComboBoxItem Content="{DynamicResource Loc24}" Tag="5"/><ComboBoxItem Content="{DynamicResource Loc25}" Tag="10"/>
              <ComboBoxItem Content="{DynamicResource Loc26}" Tag="15"/><ComboBoxItem Content="{DynamicResource Loc27}" Tag="30"/>
              <ComboBoxItem Content="{DynamicResource Loc28}" Tag="60"/>
            </ComboBox>
          </Grid>

          <TextBlock Text="{DynamicResource Loc29}" FontSize="17" FontWeight="SemiBold" Foreground="#282B30" Margin="0,24,0,10"/>
          <CheckBox x:Name="StartWithWindowsCheckBox" Content="{DynamicResource Loc30}" Margin="0,0,0,9" FontSize="13"/>
          <CheckBox x:Name="StartWithCodexCheckBox" Content="{DynamicResource Loc31}" Margin="0,0,0,0" FontSize="13"/>

          <TextBlock Text="{DynamicResource Loc48}" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Loc49}" VerticalAlignment="Center" FontSize="13"/>
            <ComboBox x:Name="LanguageModeComboBox" Grid.Column="1" Height="30" SelectedValuePath="Tag" ToolTip="中文 / English">
              <ComboBoxItem Content="{DynamicResource Loc34}" Tag="System"/>
              <ComboBoxItem Content="中文" Tag="zh-CN"/>
              <ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>
          </Grid>

          <TextBlock Text="{DynamicResource Loc32}" FontSize="17" FontWeight="SemiBold" Foreground="#282B30" Margin="0,24,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Loc33}" FontSize="13" Foreground="#454850" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeModeComboBox" Grid.Column="1" Height="30" SelectedValuePath="Tag">
              <ComboBoxItem Content="{DynamicResource Loc34}" Tag="System"/><ComboBoxItem Content="{DynamicResource Loc35}" Tag="Light"/><ComboBoxItem Content="{DynamicResource Loc36}" Tag="Dark"/>
            </ComboBox>
          </Grid>
          <TextBlock Text="{DynamicResource Loc37}" FontSize="17" FontWeight="SemiBold" Foreground="#282B30" Margin="0,24,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Loc38}" FontSize="13" Foreground="#454850" VerticalAlignment="Center"/>
            <ComboBox x:Name="EdgeBarSizeComboBox" Grid.Column="1" Height="30" SelectedValuePath="Tag">
              <ComboBoxItem Content="{DynamicResource Loc39}" Tag="67"/><ComboBoxItem Content="{DynamicResource Loc40}" Tag="100"/><ComboBoxItem Content="{DynamicResource Loc41}" Tag="133"/>
            </ComboBox>
          </Grid>
          <TextBlock Text="{DynamicResource Loc42}" FontSize="17" FontWeight="SemiBold" Foreground="#282B30" Margin="0,24,0,10"/>
          <CheckBox x:Name="ShowQuotaCardCheckBox" Content="{DynamicResource Loc43}" Margin="0,0,0,9" FontSize="13"/>
          <CheckBox x:Name="ShowTodayCardCheckBox" Content="{DynamicResource Loc9}" Margin="0,0,0,9" FontSize="13"/>
          <CheckBox x:Name="ShowChartCardCheckBox" Content="{DynamicResource Loc44}" Margin="0,0,0,14" FontSize="13"/>
          <TextBlock Text="{DynamicResource Loc45}" FontSize="13" FontWeight="SemiBold" Foreground="#555961" Margin="0,0,0,9"/>
          <CheckBox x:Name="ShowLifetimeTokensCardCheckBox" Content="{DynamicResource Loc12}" Margin="12,0,0,8" FontSize="13"/>
          <CheckBox x:Name="ShowPeakDailyTokensCardCheckBox" Content="{DynamicResource Loc13}" Margin="12,0,0,8" FontSize="13"/>
          <CheckBox x:Name="ShowLongestTurnCardCheckBox" Content="{DynamicResource Loc14}" Margin="12,0,0,8" FontSize="13"/>
          <CheckBox x:Name="ShowCurrentStreakCardCheckBox" Content="{DynamicResource Loc15}" Margin="12,0,0,8" FontSize="13"/>
          <CheckBox x:Name="ShowLongestStreakCardCheckBox" Content="{DynamicResource Loc16}" Margin="12,0,0,0" FontSize="13"/>
        </StackPanel>
      </Border>
    </ScrollViewer>
    <Border Background="#F6F7F9" VerticalAlignment="Bottom" Height="54" Padding="16,10">
      <Grid>
        <TextBlock x:Name="VersionText" VerticalAlignment="Center" Foreground="#92959D" FontSize="11"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{DynamicResource Loc46}" Width="76" Height="31" Margin="0,0,8,0" Click="CancelButton_Click"/>
          <Button Content="{DynamicResource Loc47}" Width="76" Height="31" Click="SaveButton_Click" Background="#43C979" Foreground="White" BorderBrush="#36B96C"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
